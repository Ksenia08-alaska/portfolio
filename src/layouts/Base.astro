---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/onest';
import '../styles/global.css';
import { site } from '../content/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import Cursor from '../components/Cursor.astro';
import Lightbox from '../components/Lightbox.astro';
import Intro from '../components/Intro.astro';

interface Props {
  title?: string;
  description?: string;
  intro?: boolean;
}
const { title = site.seo.title, description = site.seo.description, intro = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(site.seo.ogImage, site.url).href;
---
<!doctype html>
<html lang={site.lang} data-intro={intro ? 'on' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.demo && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f3ebdf" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.person.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) d.classList.add('reduce');
        try {
          if (d.dataset.intro === 'on' && !reduce && !sessionStorage.getItem('kk-intro')) d.classList.add('intro');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">К содержанию</a>
    {intro && <Intro />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCta />
    <Cursor />
    <Lightbox />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
