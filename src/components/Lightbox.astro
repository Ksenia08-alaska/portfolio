---
// Окно для просмотра скрина целиком. Открывается кликом по скрину в кейсе.
---
<dialog class="lightbox" data-lightbox data-lenis-prevent aria-label="Скрин целиком">
  <button class="lightbox__close" type="button" data-lightbox-close aria-label="Закрыть">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
  </button>
  <div class="lightbox__scroll">
    <img data-lightbox-img alt="" />
  </div>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--milk);
    overflow: hidden;
  }
  .lightbox::backdrop { background: rgb(20 11 6 / 0.9); }
  .lightbox__scroll {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: calc(env(safe-area-inset-top, 0px) + 72px) var(--pad-x) calc(env(safe-area-inset-bottom, 0px) + 40px);
    -webkit-overflow-scrolling: touch;
  }
  .lightbox__scroll img {
    display: block;
    width: 100%;
    max-width: 1200px;
    height: auto;
    margin-inline: auto;
    border-radius: 14px;
    cursor: zoom-out;
  }
  .lightbox.is-phone .lightbox__scroll img { max-width: 430px; border-radius: 28px; }
  .lightbox__close {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 14px);
    right: calc(env(safe-area-inset-right, 0px) + 14px);
    z-index: 2;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--orange);
    color: var(--espresso);
    cursor: pointer;
  }
  .lightbox__close svg { width: 22px; height: 22px; pointer-events: none; }
  .lightbox__close:focus-visible { outline: 3px solid var(--milk); outline-offset: 3px; }
</style>
