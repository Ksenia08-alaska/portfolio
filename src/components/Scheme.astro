---
// Схема-конвейер вместо скринов (для проектов, где скрины не нужны)
interface Props { steps: string[]; tone?: 'dark' | 'milk' }
const { steps, tone = 'dark' } = Astro.props;
---
<ol class:list={['scheme', `scheme--${tone}`]} aria-label="Как работает проект">
  {steps.map((s, i) => (
    <li class="scheme__step" style={`--i:${i}`}>
      <span class="scheme__num" aria-hidden="true">{i + 1}</span>
      <span class="scheme__text">{s}</span>
    </li>
  ))}
</ol>

<style>
  .scheme {
    --bg: var(--espresso);
    --fg: var(--milk);
    --line: rgba(243, 235, 223, 0.22);
    list-style: none;
    margin: 0;
    padding: 0;
    width: min(100%, 360px);
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.6vw, 16px);
    position: relative;
  }
  .scheme--milk { --bg: var(--milk); --fg: var(--espresso); --line: rgba(31, 18, 11, 0.2); }
  .scheme::before {
    content: '';
    position: absolute;
    left: 27px;
    top: 24px;
    bottom: 24px;
    border-left: 2px dashed var(--line);
  }
  .scheme__step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 18px 10px 10px;
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg);
    font-weight: 600;
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    line-height: 1.25;
    animation: pulse-step 5s var(--ease-out) infinite;
    animation-delay: calc(var(--i) * 0.8s);
  }
  .scheme__num {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--orange);
    color: var(--espresso);
    font-family: var(--font-display);
    font-size: 0.85rem;
  }
  .scheme__text { min-width: 0; }
  @keyframes pulse-step {
    0%, 12% { transform: translateX(0); }
    6% { transform: translateX(8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scheme__step { animation: none; }
  }
</style>
